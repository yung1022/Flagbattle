# Google Cloud OAuth client with YouTube Data API v3 enabled
# Mobile / device login: type "TVs and Limited Input devices"
# Desktop localhost login: type "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produced by: npm run auth / auth:device --prefix stream
# Or Mobile control hub → Setup tab
GOOGLE_REFRESH_TOKEN=

# Optional overrides
# YT_PRIVACY=public
# YT_TITLE=FLAG BATTLE — Last Flag Standing
# YT_DESCRIPTION=All-country hole-circle battle. Qualifying then Final.
# GAME_PORT=5173
# STREAM_WIDTH=1080
# STREAM_HEIGHT=1920
# STREAM_FPS=30
# DEMO_SECONDS=90
# Public website root for on-stream QR / poll / rankings links
# PUBLIC_SITE=https://yung1022.github.io/Flagbattle

# Subscriber count on stream (pick one):
# A) OAuth above → uses the authenticated livestream channel (mine=true)
# B) API key + channel id / handle
# YOUTUBE_API_KEY=
# YT_CHANNEL_ID=UCxxxxxxxx
# YT_CHANNEL_HANDLE=@YourHandle
