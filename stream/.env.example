# Google Cloud OAuth client with YouTube Data API v3 enabled
# Mobile / device login: type "TVs and Limited Input devices"
# Desktop localhost login: type "Desktop app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Produced by: npm run auth / auth:device --prefix stream
# Or Mobile control hub → Setup tab
GOOGLE_REFRESH_TOKEN=

# Optional overrides
# YT_PRIVACY=public
# YT_TITLE=FLAG BATTLE — Last Flag Standing
# YT_DESCRIPTION=All-country hole-circle battle. Qualifying then Final.
# Comma-separated YouTube tags (Studio → Tags). Defaults include 10+ tags.
# YT_TAGS=flag battle,country flags,livestream,youtube shorts,geography game
# Comma-separated description keywords / hashtag seeds (defaults include 15).
# YT_KEYWORDS=flag battle,last flag standing,shorts livestream,world flags battle
# YT_CATEGORY_ID=20
# GAME_PORT=5173
# STREAM_WIDTH=720
# STREAM_HEIGHT=1280
# STREAM_FPS=30
# STREAM_PRESET=ultrafast
# DEMO_SECONDS=90
# Public website root for poll / rankings (posted to live chat)
# (defaults to GitHub Pages — never 127.0.0.1 for viewers)
# PUBLIC_SITE=https://yung1022.github.io/Flagbattle
# Thumbnail: use assets/thumbnail-yt.jpg (<2MB). Channel must be verified for custom thumbs.
# Optional public API tunnel (auto-set by cloudflared during go-live)
# PUBLIC_API=https://xxxx.trycloudflare.com
# DISABLE_TUNNEL=1

# Nightbot !vote (backup — no YouTube Data API chat quota)
# Create a token at https://nightbot.tv → account with `commands` scope, or use
# https://api-docs.nightbot.tv/ → authorize with scope `commands`.
# NIGHTBOT_TOKEN=
# NIGHTBOT_COMMAND_NAME=!vote
# NIGHTBOT_COOLDOWN=3
# Bare country names (Japan / us) need the chat listener.
# Default ON in go-live via Innertube (same as the website — no Data API list quota).
# Set CHAT_VOTE=0 to rely on Nightbot !vote + web poll only.
# CHAT_VOTE=1
# CHAT_VOTE=0
# Chat read source: innertube (default) | api (liveChatMessages.list — burns quota)
# CHAT_VOTE_SOURCE=innertube
# Optional bot replies in chat still use Data API inserts (set 0 to silence + save units)
# CHAT_VOTE_REPLIES=1
# CHAT_VOTE_REPLIES=0

# Subscriber count on stream (pick one):
# A) OAuth above → uses the authenticated livestream channel (mine=true)
# B) API key + channel id / handle
# YOUTUBE_API_KEY=
# YT_CHANNEL_ID=UCxxxxxxxx
# YT_CHANNEL_HANDLE=@YourHandle
